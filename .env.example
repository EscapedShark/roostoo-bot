# 默认观察：模拟成交，绝不调用下单接口。test/competition 才会真实调用 Roostoo。
BOT_MODE=observe
ROOSTOO_API_KEY=
ROOSTOO_SECRET_KEY=

# protected = 原 protected_strategy 默认全套保护；baseline = 原冻结信号。
# 1/1 保留原版；2/2 是研究滞后确认参数，不能混用同一状态目录。
STRATEGY_VARIANT=protected
RANK_EXIT_DAYS=1
STRUCTURE_EXIT_DAYS=1
WARMUP_START=2026-05-01T00:00:00Z
OBSERVE_INITIAL_CASH=100000
OBSERVE_FEE=0.001
BUY_COST_RESERVE=0.005
POLL_SECONDS=4

# 可选：带时区的 ISO 时间，到时停止发单。留空则持续运行，最终清仓由 Roostoo 处理。
# 首次启动后写入账户指纹，之后不能再修改。
COMPETITION_END_UTC=
# 可选，默认使用本目录下的 state/ 和 logs/。
# STATE_DIR=/home/ssm-user/roostoo-bot/state
# LOG_DIR=/home/ssm-user/roostoo-bot/logs
